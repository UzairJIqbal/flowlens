# Copy to agent/.env. The agent runs as its own service, beside the app.

# The model's key (Gemini).
GOOGLE_API_KEY=

# LangSmith tracing. Optional.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=flowlens

# Where the app is running. The agent's tools read the analysis from here.
FLOWLENS_URL=http://localhost:3000
