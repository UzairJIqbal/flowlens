# Copy to .env.local and fill in. `next dev` and `next build` refuse to start
# while any variable without a default here is empty (see lib/env.ts).

# Clerk: sign-in and organizations. Dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/analyses
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/analyses

# Supabase: Postgres, row-level security, realtime. Project settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; used by the pipeline's writer alone.
SUPABASE_SECRET_KEY=

# Gemini, called through its OpenAI-compatible endpoint.
GOOGLE_API_KEY=

# LangSmith tracing. Optional: without it, AI calls run untraced.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=flowlens

# The agent service in agent/ (`pnpm --dir agent dev`). Optional: without it
# the Ask panel says so and everything else keeps working.
AGENT_URL=http://localhost:2024
